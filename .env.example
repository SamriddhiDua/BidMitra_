# BidMitra environment variables
# Copy this file to .env and fill in values. Never commit .env to git.

# ---- AI Model Provider ----
# Options: "ollama" (local, default) | "openai_compatible" (hosted open-weight)
LLM_PROVIDER=ollama

# ---- Ollama (local, default) ----
# Base URL for your local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# ---- Model name (required for both providers) ----
# Example: phi3:mini  llama3.2:3b  qwen2.5:3b  mistral:7b
OPEN_LLM_MODEL=phi3:mini

# ---- OpenAI-compatible hosted endpoint (if LLM_PROVIDER=openai_compatible) ----
# OPEN_LLM_BASE_URL=http://your-server:8000
# OPEN_LLM_API_KEY=sk-your-key-here          # optional; leave blank if not required

# ---- Model license URL (shown in the AI badge in the UI) ----
# Fill in the real URL for whichever model you use.
# OPEN_LLM_LICENSE_URL=<FILL_MODEL_LICENSE_URL>
